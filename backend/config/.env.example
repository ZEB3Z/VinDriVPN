# Copy this file to ".env" (same folder) and fill in your own values.

PORT=4001
NODE_ENV=DEVELOPMENT

# Local MongoDB connection string. If you installed MongoDB Community Server
# with default settings, this is almost always correct as-is.
DB_URI=mongodb://localhost:27017/vindri

# Any long random string works. Used to sign login tokens.
JWT_SECRET=change_this_to_any_long_random_string
JWT_EXPIRES_TIME=7d

# Optional: only needed if you want password-reset emails to actually send.
# If left blank, the app still works; the reset link will just be printed
# to the backend console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@vindri.local
SMTP_FROM_NAME=VinDri VPN
